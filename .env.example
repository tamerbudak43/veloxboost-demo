# Local PostgreSQL connection. Never commit a real password or production URL.
DATABASE_URL=postgresql://velox:velox@localhost:5432/velox

# Browser-visible base URL used by Better Auth in local development.
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap only the first local admin. Remove this setting before production.
INITIAL_ADMIN_EMAIL=admin@velox.local

# Public receiving addresses used only for member deposit instructions.
# TON requires its public Memo/Tag together with the address. Never put private
# keys, seed phrases, or exchange API secrets in this file.
VELOX_USDT_MIN_DEPOSIT=100
VELOX_USDT_TON_ADDRESS=
VELOX_USDT_TON_MEMO=
VELOX_USDT_BEP20_ADDRESS=
VELOX_USDT_POLYGON_ADDRESS=
VELOX_USDT_ERC20_ADDRESS=
VELOX_USDT_TRC20_ADDRESS=

# Password reset email delivery (server-only). Verify veloxboost.online in Resend first.
RESEND_API_KEY=
AUTH_EMAIL_FROM="VELOX <noreply@veloxboost.online>"
